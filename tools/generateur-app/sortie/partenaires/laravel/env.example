# ==================================================================
#  Gestion des Partenaires (partenaires) — Laravel 11 branché sur l'IAM-Local
#  Copier en .env puis : php artisan key:generate
# ==================================================================

APP_NAME="Gestion des Partenaires"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de l'application (SQLite par défaut : rien à installer).
# Sous WAMP, MySQL :
#   DB_CONNECTION=mysql / DB_HOST=127.0.0.1 / DB_PORT=3306
#   DB_DATABASE=partenaires / DB_USERNAME=root / DB_PASSWORD=
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=partenaires
# DB_USERNAME=root
# DB_PASSWORD=

# Cookie de session PROPRE à l'application : les navigateurs ne
# distinguent pas les ports, et toutes les applications Laravel servies
# sur « localhost » partageraient sinon le même cookie laravel_session
# (une connexion sur :8001 fermerait la session de :8002).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=partenaires_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Le cache conserve les clés publiques de l'IAM (JWKS).
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==================================================================
#  IAM-Local (« IAM ACSI ») — voir config/services.php, clé « iam »
# ==================================================================

# Voie de connexion par défaut de /login : oidc (recommandé) | sso
IAM_AUTH_MODE=oidc

# URL publique de l'IAM = IAM_BASE_URL de config/config.php côté IAM.
IAM_BASE_URL=http://localhost/IAM-Local
# URL de l'IAM vue par le serveur Laravel, si différente (sinon vide).
IAM_INTERNAL_URL=
# Émetteur attendu (claim iss). Vide = IAM_BASE_URL.
IAM_OIDC_ISSUER=

# Code de l'application dans l'IAM (applications.code).
IAM_APP_CODE=partenaires

# Client OIDC (oauth_clients) — confidentiel, PKCE S256 obligatoire.
IAM_OIDC_CLIENT_ID=iam-laravel-partenaires
# Secret : en local, celui indiqué en tête de sql/seed-app-partenaires.sql
# côté IAM. Ailleurs : Administration > Applications OAuth / OIDC >
# Régénérer le secret (affiché une seule fois).
IAM_OIDC_CLIENT_SECRET=
IAM_OIDC_REDIRECT_URI=http://localhost:8001/callback
IAM_OIDC_POST_LOGOUT_URI=http://localhost:8001/logged-out
IAM_OIDC_SCOPES="openid profile email roles offline_access"

# SSO maison (IAM_AUTH_MODE=sso, ou lien /login/sso)
IAM_SSO_PROMPT=false
IAM_SSO_SESSION_TTL=28800

# Aucune permission reçue de l'IAM → lecture seule (*.view).
IAM_READONLY_FALLBACK=true

IAM_JWKS_CACHE_TTL=3600
IAM_HTTP_TIMEOUT=10
IAM_VERIFY_TLS=true
